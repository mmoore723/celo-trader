[Unit]
Description=Celo Trader Dashboard (FastAPI + React)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/celo_trader
Environment="CELO_ENV=production"
Environment="PYTHONPATH=/opt/celo_trader"
EnvironmentFile=/opt/celo_trader/.env
# Uvicorn serves the FastAPI backend.
# The built React frontend is served as static files by FastAPI itself.
# Bound Uvicorn's connection/task drain so a deploy cannot sit in "stopping"
# until systemd's 90-second SIGKILL deadline. The application lifespan hook
# gets up to 15 seconds to stop trading-loop workers; five more seconds lets
# Uvicorn finish closing sockets and flush logs.
ExecStart=/opt/celo_trader/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8501 --workers 1 --timeout-graceful-shutdown 20
Restart=always
RestartSec=5
StandardOutput=append:/opt/celo_trader/log/dashboard.log
StandardError=append:/opt/celo_trader/log/dashboard.log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/celo_trader

[Install]
WantedBy=multi-user.target
